# Пример переменных окружения для TPS API Documentation

# Базовый URL для API (по умолчанию используется из OpenAPI спецификации)
VITE_API_BASE_URL=https://ecom-api-test.paynet.md

# Заголовок приложения
VITE_APP_TITLE=TPS API Documentation Portal

# Язык по умолчанию (en, ro, ru)
VITE_DEFAULT_LANGUAGE=en

# Режим разработки (development, production)
NODE_ENV=production