{
  "openapi": "3.0.1",
  "info": {
    "title": "API Ecom",
    "version": "v1"
  },
  "paths": {
    "/api/linked-cards/unlink": {
      "post": {
        "tags": [
          "LinkedCard"
        ],
          "summary": "Unlinks (deletes) a previously saved payment card for a specific customer.",
          "requestBody": {
          "description": "The payload containing the details needed to identify and unlink the card.",
          "content": {
            "application/json": {
							"example": {
              "CardLinkHash": "1037153_b3f50103610e4fe9948ff8db553151f3",
              "SaleAreaCode": "",
              "CustomerCode": "customer_code"
          }
						}
          }
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/order": {
      "post": {
        "tags": [
          "Order"
        ],
        "summary": "Registers a new payment transaction based on the provided request data.",       
        "requestBody": {
          "description": "The payload containing the payment details",
          "content": {
            "application/json": {
							"example": {
                      "Order": 65465465,
                      "SaleAreaCode": "onlidocumentation_md",
                      "LinkUrlSuccess": "https://shop-test.com/success",
                      "LinkUrlCancel": "https://shop-test.com/cancel",
                      "CardLinkHash": "1043650_db78d40d62d84675bb75d70bd31ac621",
                      "Customer": {
                        "Code": "464566161",
                        "NameFirst": "First Name",
                        "NameLast": "Last Name",
                        "email": "mytestemail@gmail.com",
                        "PhoneNumber": "37360000000"
                      },
                      "Currency": 498,
                      "ExpiryDate": "2026-05-01T00:00:00",
                      "Services": [
                        {
                          "Name": "Demo eShop",
                          "Description": "Demo eShop online desc",
                          "Amount": 300,
                          "Products": [
                            {
                              "Amount": 300,
                              "Code": "546465654",
                              "Description": "Demo product",
                              "LineNo": 1,
                              "Name": "Demo product",
                              "UnitPrice": 100,
                              "Quantity": 3,
                              "TotalAmount": 300
                            }
                          ]
                        }
                      ],
                      "MoneyType": "all",
                      "Lang": "EN"
                    }
						}
          }
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/{id}": {
      "get": {
        "tags": [
          "Order"
        ],
        "summary": "Retrieves the details and current status of a specific payment transaction.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique identifier of the payment transaction to retrieve.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/merchant/{id}": {
      "get": {
        "tags": [
          "Order"
        ],
        "summary": "Retrieves the details of a payment transaction using the merchant's specific order ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique order identifier provided by the merchant.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/search": {
      "get": {
        "tags": [
          "Order"
        ],
        "summary": "Searches for payment transactions within a specified date range.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
             "required": true,
            "description": "The starting date and time of the search interval.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
             "required": true,
            "description": "The ending date and time of the search interval.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/order/refund": {
      "post": {
        "tags": [
          "Order"
        ],
        "summary": "Initiates a refund process for a previously completed payment transaction.",
        "requestBody": {
          "description": "The payload containing the necessary details to process the refund.",
          "content": {
						"application/json": {
							"example": {
								"PaymentId": 296901,
								"Amount": 50000,
								"SaleAreaCode": "onlidocumentation_md",
								"Currency": 498,
								"RefundType": "full",
								"Reason": "Was customer error!"
							}
						}
					}
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/statement": {
      "get": {
        "tags": [
          "Statement"
        ],
        "summary": "Retrieves the financial statement details for a specified date range.",
        "parameters": [
          {
            "name": "dateStart",
            "in": "query",
             "required": true,
            "description": "The starting date of the statement period.",
            "schema": { 
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "dateFinish",
            "in": "query",
             "required": true,
            "description": "The ending date of the statement period.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "accountId",
            "in": "query",
            "description": "(Optional) The specific account identifier to filter the statement.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/statement/download": {
      "get": {
        "tags": [
          "Statement"
        ],
        "summary": "Generates and downloads a financial statement report in Excel (.xlsx) format for the specified date range.",
        "parameters": [
          {
            "name": "dateStart",
            "in": "query",
            "required": true,
            "description": "The starting date of the report period.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "dateFinish",
            "in": "query",
             "required": true,
            "description": "The ending date of the report period (must be within 31 days of the start date).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    },
    "/auth": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Auth action for partner users",
        "requestBody": {
          "description": "",
          "content": {
	          "application/json": {
							"example": {
              "grantType": "password",
              "username": "771064",
              "password": "sLgMnGWJ"
            }
						}
          }
        },
        "responses": {
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthRequest": {
        "required": [
          "grantType",
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "grantType": {
            "minLength": 1,
            "type": "string",
            "description": "The authorization grant type (e.g., \"password\")."
          },
          "username": {
            "minLength": 1,
            "type": "string",
            "description": "The user's username."
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "description": "The user's password in plain text."
          }
        },
        "additionalProperties": false,
        "description": "The authentication request model."
      },
      "Customer": {
        "required": [
          "Code"
        ],
        "type": "object",
        "properties": {
          "Code": {
            "type": "string",
            "description": "The unique code or identifier for the customer.",
            "nullable": true
          },
          "NameFirst": {
            "type": "string",
            "description": "(Optional) The customer's first name.",
            "nullable": true
          },
          "NameLast": {
            "type": "string",
            "description": "(Optional) The customer's last name.",
            "nullable": true
          },
          "email": {
            "type": "string",
            "description": "(Optional) The customer's email address.",
            "nullable": true
          },
          "PhoneNumber": {
            "type": "string",
            "description": "(Optional) The customer's phone number.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents the customer details for a payment."
      },
      "DeleteLinkedCardRequest": {
        "required": [
          "cardLinkHash",
          "customerCode",
          "saleAreaCode"
        ],
        "type": "object",
        "properties": {
          "cardLinkHash": {
            "type": "string",
            "description": "The unique hash identifying the specific card to be unlinked.",
            "nullable": true
          },
          "saleAreaCode": {
            "type": "string",
            "description": "The code identifying the specific sale area or merchant environment.",
            "nullable": true
          },
          "customerCode": {
            "type": "string",
            "description": "The unique identifier or code of the customer who owns the linked card.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents the payload required to unlink a saved payment card."
      },
      "ErrorModel": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "Gets or sets the HTTP status code associated with the error (e.g., 400, 401, 500).",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "description": "Gets or sets a human-readable, descriptive error message intended for the client.",
            "nullable": true
          },
          "code": {
            "type": "string",
            "description": "Gets or sets the internal business logic error code or its string representation.",
            "nullable": true
          },
          "traceId": {
            "type": "string",
            "description": "Gets or sets an optional unique identifier used for request tracing and debugging in the logs.",
            "nullable": true
          },
          "details": {
            "type": "string",
            "description": "Gets or sets optional technical details or additional context regarding the error \r\n(e.g., specific validation failures).",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents a standardized error response returned by the API."
      },
      "PaymentRequest": {
        "required": [
          "Currency",
          "ExpiryDate",
          "Lang",
          "LinkUrlCancel",
          "LinkUrlSuccess",
          "MoneyType",
          "Order",
          "SaleAreaCode",
          "Services"
        ],
        "type": "object",
        "properties": {
          "Order": {
            "type": "integer",
            "description": "The unique identifier for the order.",
            "format": "int64"
          },
          "SaleAreaCode": {
            "type": "string",
            "description": "The code representing the sale area or merchant location.",
            "nullable": true
          },
          "LinkUrlSuccess": {
            "type": "string",
            "description": "The URL to redirect to upon a successful payment.",
            "nullable": true
          },
          "LinkUrlCancel": {
            "type": "string",
            "description": "The URL to redirect to if the payment is canceled.",
            "nullable": true
          },
          "CardLinkHash": {
            "type": "string",
            "description": "(Optional) Linked-card hash. If CardLinkHash is provided, the full Customer object (Code, NameFirst, NameLast, email, PhoneNumber) becomes required.",
            "nullable": true
          },
          "Customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "Currency": {
            "type": "integer",
            "description": "The currency code.",
            "format": "int32"
          },
          "ExpiryDate": {
            "type": "string",
            "description": "The expiration date and time for this payment request.",
            "format": "date-time"
          },
          "Services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "description": "The list of services included in this payment.",
            "nullable": true
          },
          "MoneyType": {
            "enum": [
              "All",
              "Card",
              "Paynet",
              "MIA",
              "CashInvoice"
            ],
            "type": "string",
            "description": "Payment method type: \"Card\" for Visa&Mastercard; \"Paynet\" for Paynet Wallet; \"MIA\" for Mia; \"Cash Invoice\" for cash invoice; \"All\" for Все доступные способы."
          },
          "Lang": {
            "type": "string",
            "description": "UI language for payment page (example: RO or RU or EN).",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents the payload for initiating a payment request. Fields not marked as required are optional."
      },
      "Product": {
        "required": [
          "Amount",
          "Code",
          "Description",
          "LineNo",
          "Name",
          "Quantity",
          "TotalAmount",
          "UnitPrice"
        ],
        "type": "object",
        "properties": {
          "LineNo": {
            "type": "integer",
            "description": "The line number or position of the product in the list.",
            "format": "int32"
          },
          "Name": {
            "type": "string",
            "description": "The name of the product.",
            "nullable": true
          },
          "Description": {
            "type": "string",
            "description": "(Optional) The description of the product.",
            "nullable": true
          },
          "Code": {
            "type": "string",
            "description": "(Optional) Partner product code.",
            "nullable": true
          },
          "UnitPrice": {
            "type": "integer",
            "description": "The price per single unit of the product.",
            "format": "int64"
          },
          "Quantity": {
            "type": "integer",
            "description": "The quantity of the product being purchased.",
            "format": "int64"
          },
          "Amount": {
            "type": "integer",
            "description": "The total amount for this quantity (usually UnitPrice * Quantity).",
            "format": "int64"
          },
          "TotalAmount": {
            "type": "integer",
            "description": "The final total amount including any taxes or discounts.",
            "format": "int64"
          }
        },
        "additionalProperties": false,
        "description": "Represents a single product item within a service."
      },
      "RefundRequest": {
        "required": [
          "reason",
          "refundType",
          "saleAreaCode"
        ],
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "integer",
            "description": "The unique internal identifier of the original payment transaction to be refunded.",
            "format": "int64"
          },
          "saleAreaCode": {
            "type": "string",
            "description": "The code identifying the specific sale area or point of sale where the original transaction occurred.",
            "nullable": true
          },
          "refundType": {
            "type": "string",
            "description": "The type of refund being requested (e.g., \"Full\", \"Partial\").",
            "nullable": true
          },
          "amount": {
            "type": "integer",
            "description": "The exact amount to be refunded.",
            "format": "int64"
          },
          "currency": {
            "type": "integer",
            "description": "The numeric ISO code of the currency for the refund amount.",
            "format": "int32"
          },
          "reason": {
            "type": "string",
            "description": "A descriptive reason or justification for processing the refund.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents the payload required to initiate a refund for a specific payment transaction."
      },
      "Service": {
        "required": [
          "Amount",
          "Description",
          "Name"
        ],
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "The name of the service.",
            "nullable": true
          },
          "Description": {
            "type": "string",
            "description": "The description of the service.",
            "nullable": true
          },
          "Amount": {
            "type": "integer",
            "description": "The total amount for this service.",
            "format": "int64"
          },
          "Products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            },
            "description": "(Optional) A list of specific products under this service. If at least one Products field is provided, all Product fields become required.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Represents a service included in the payment request."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Only token.",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
    {
      "name": "LinkedCard",
      "description": "Handles operations related to saved or linked payment cards for authorized users."
    },
    {
      "name": "Order",
      "description": "Psp Controller"
    },
    {
      "name": "Statement",
      "description": "Handles operations related to merchant financial statements, including data retrieval and exporting reports."
    },
    {
      "name": "User",
      "description": "User controller"
    }
  ]
}